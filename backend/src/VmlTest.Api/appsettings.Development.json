{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ---------------------------------------------------------------------------
  // Valores SOLO para desarrollo local. No se usan en producción: cuando la API
  // corre en la nube, la cadena de conexión y la clave JWT llegan por variables
  // de entorno del proveedor y estos valores no se leen.
  // ---------------------------------------------------------------------------

  // Apunta al PostgreSQL del docker-compose.yml de la raíz del repositorio.
  // Si usa otra base (por ejemplo la de pgAdmin), sobrescriba esta clave con:
  //   dotnet user-secrets set "ConnectionStrings:Default" "Host=...;Port=5432;Database=vmltest;Username=...;Password=..."
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vmltest;Username=vml;Password=vml"
  },

  // Clave de juguete para firmar los tokens en local. En producción se sustituye
  // por una variable de entorno con un valor largo y aleatorio.
  "Jwt": {
    "Secret": "clave-solo-para-desarrollo-local-no-usar-en-produccion"
  },

  // Origen por defecto del frontend Angular cuando se levanta con ng serve.
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  }
}
