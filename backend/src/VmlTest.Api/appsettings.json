{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Sin valores a propósito: en local se define con user-secrets y en el servidor
  // con variables de entorno. Así no queda ninguna credencial en el repositorio.
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "VmlTest.Api",
    "Audience": "VmlTest.Clients",
    "Secret": "",
    "ExpirationMinutes": 60
  },
  // Dominios autorizados a llamar la API desde un navegador, separados por comas.
  // Ejemplo en producción: Cors__AllowedOrigins=https://mi-front.vercel.app
  "Cors": {
    "AllowedOrigins": ""
  }
}
