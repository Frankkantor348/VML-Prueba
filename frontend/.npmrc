# npm 10.9.x tiene un fallo en su resolvedor de dependencias (Arborist) al montar el
# conjunto de "peer dependencies" de vitest: termina con
# "Cannot read properties of null (reading 'edgesOut')" y no instala nada.
#
# Como el package-lock.json se generó con esta misma opción, hay que dejarla fijada
# aquí: si no, `npm ci` en el servidor de despliegue detectaría una inconsistencia.
legacy-peer-deps=true
